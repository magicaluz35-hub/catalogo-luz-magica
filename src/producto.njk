---
layout: base.njk
pagination:
  data: productos
  size: 1
  alias: p
permalink: "/producto/{{ p.sku | lower }}/"
sinFlotante: true
eleventyComputed:
  titulo: "{{ p.nombre }} · {{ negocio.nombre }}"
  descripcion: "{{ p.descripcion or p.nombre }} Fabricación bajo pedido en Medellín, pago contra entrega."
  ogImagen: "{{ p.fotos[0] if p.fotos.length else '' }}"
---
{% from "tarjeta.njk" import producto as tarjetaProducto %}
{% set cat = categorias | categoriaDe(p.categoria) %}
{% set relacionados = productos | deCategoria(p.categoria) | menos(p.sku) %}

<nav class="migas contenedor" aria-label="Migas de pan">
  <a href="/">Inicio</a>
  <span aria-hidden="true">/</span>
  {% if cat %}<a href="/categoria/{{ cat.slug }}/">{{ cat.nombre }}</a><span aria-hidden="true">/</span>{% endif %}
  <span>{{ p.nombre }}</span>
</nav>

<section class="seccion seccion--corta">
  <div class="contenedor ficha">

    <div class="ficha__fotos" data-galeria>
      {% if p.fotos and p.fotos.length %}
      <a class="foto foto--4-5 foto--grande ficha__principal" href="{{ p.fotos[0] }}" data-galeria-abrir aria-label="Ver la foto en grande">
        <img src="{{ p.fotos[0] }}" alt="{{ p.nombre }}" width="720" height="900" data-galeria-principal>
        <span class="ficha__lupa" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><circle cx="11" cy="11" r="6.4"></circle><path d="M15.8 15.8L20.5 20.5"></path><path d="M11 8.6v4.8"></path><path d="M8.6 11h4.8"></path></svg>
        </span>
      </a>
      {% else %}
      <div class="foto foto--4-5 foto--grande">
        <span class="foto__vacia">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="3" y="4.5" width="18" height="15" rx="2"></rect><circle cx="8.8" cy="10" r="1.9"></circle><path d="M3.5 17.2l5-4.2 3.6 3 3-2.4 5.4 4.6"></path></svg>
          <span>Foto principal</span>
        </span>
      </div>
      {% endif %}

      {% if p.fotos and p.fotos.length > 1 %}
      <div class="ficha__miniaturas">
        {% for f in p.fotos %}
        <a class="foto foto--1-1 miniatura{{ ' miniatura--activa' if loop.first }}" href="{{ f }}" data-galeria-ir="{{ loop.index0 }}" aria-label="Ver la foto {{ loop.index }} de {{ p.fotos.length }}">
          <img src="{{ f }}" alt="" loading="lazy" width="200" height="200">
        </a>
        {% endfor %}
      </div>
      {% endif %}
    </div>

    <div class="ficha__datos">
      {% if p.destacado %}<span class="etiqueta etiqueta--suelta">Destacado</span>{% endif %}
      <p class="rotulo">SKU {{ p.sku }}</p>
      <h1>{{ p.nombre }}</h1>
      <p class="ficha__precio">{{ p.precio | pesos }}</p>

      {% if p.descripcion %}
      <p class="parrafo">{{ p.descripcion }} Disponible en {% for c in negocio.colores %}{{ c.nombre | lower }}{% if loop.revindex == 2 %} o {% elif not loop.last %}, {% endif %}{% endfor %}.</p>
      {% else %}
      <p class="parrafo">Se fabrica en {% for c in negocio.colores %}{{ c.nombre | lower }}{% if loop.revindex == 2 %} o {% elif not loop.last %}, {% endif %}{% endfor %}, con el enchape que elijas.</p>
      {% endif %}

      <p class="aviso-plazo">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="8.6"></circle><path d="M12 7.4V12l3 1.8"></path></svg>
        <span>{{ p.plazo if p.plazo else negocio.plazoFabricacion }}</span>
      </p>

      <form class="opciones" data-opciones>
        <fieldset>
          <legend class="rotulo">Color del mueble</legend>
          <div class="muestras">
            {% for c in negocio.colores %}
            <label class="muestra">
              <input type="radio" name="color" value="{{ c.nombre }}" {{ "checked" if loop.first }}>
              <span class="muestra__disco" style="background: {{ c.hex }}"></span>
              <span class="oculto">{{ c.nombre }}</span>
            </label>
            {% endfor %}
          </div>
          <p class="opciones__elegido">Elegido: <strong data-elegido-color>{{ negocio.colores[0].nombre }}</strong></p>
        </fieldset>

        <fieldset>
          <legend class="rotulo">Enchape</legend>
          <div class="fichas">
            {% for e in negocio.enchapes %}
            <label class="ficha ficha--radio">
              <input type="radio" name="enchape" value="{{ e }}" {{ "checked" if loop.first }}>
              <span>{{ e }}</span>
            </label>
            {% endfor %}
          </div>
        </fieldset>
      </form>

      {# El pedido es la acción principal: deja juntar varios muebles y llega
         al asesor con los datos de entrega ya puestos. WhatsApp queda al lado,
         para quien solo quiere preguntar algo. #}
      <button type="button" class="boton boton--marca boton--ancho boton--grande" data-agregar
              data-sku="{{ p.sku }}" data-nombre="{{ p.nombre }}" data-precio="{{ p.precio }}"
              data-foto="{{ p.fotos[0] if p.fotos.length else '' }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.4 4.3h2.4l2.3 10.6h9.3l2-7.1H7"></path><circle cx="9.6" cy="19.1" r="1.5"></circle><circle cx="16.9" cy="19.1" r="1.5"></circle></svg>
        Añadir al pedido
      </button>

      <div class="ficha__secundarios">
        <a class="boton boton--linea boton--wa" href="#" data-wa data-wa-ficha
           data-sku="{{ p.sku }}" data-nombre="{{ p.nombre }}" data-precio="{{ p.precio | pesos }}">
          <img class="wa-logo" src="/img/whatsapp-verde.svg" alt="" width="18" height="18" aria-hidden="true">
          Preguntar por WhatsApp
        </a>
        <button type="button" class="boton boton--linea" data-compartir data-sku="{{ p.sku }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="17.5" cy="5.8" r="2.8"></circle><circle cx="6.5" cy="12" r="2.8"></circle><circle cx="17.5" cy="18.2" r="2.8"></circle><path d="M9 10.7l6-3.5"></path><path d="M9 13.3l6 3.5"></path></svg>
          Compartir
        </button>
      </div>

      <details class="previsualizacion">
        <summary class="rotulo">Ver lo que le llega al asesor</summary>
        <p data-wa-previo></p>
      </details>
      <p class="nota">Al compartir, el enlace sale con el código del asesor incluido. {{ negocio.avisoWhatsapp }}</p>

      <div class="ficha__legal">
        <h2 class="rotulo">Formas de pago</h2>
        <p class="parrafo">{{ negocio.formasDePago }}</p>
        <h2 class="rotulo">Entrega y retiro</h2>
        <p class="parrafo">{{ negocio.domicilios }} {{ negocio.retiro }}</p>
      </div>
    </div>

  </div>
</section>

{% if relacionados.length %}
<section class="seccion">
  <div class="contenedor">
    <h2 class="seccion__titulo">También te puede interesar</h2>
    <div class="rejilla rejilla--4">
      {% for r in relacionados | primeros(4) %}{{ tarjetaProducto(r, negocio) }}{% endfor %}
    </div>
  </div>
</section>
{% endif %}
