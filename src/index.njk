---
layout: base.njk
permalink: /
---
{% from "tarjeta.njk" import producto %}
{% from "iconos.njk" import atajo as iconoAtajo %}
{% from "ilustraciones.njk" import ilustracion %}
{% from "iconos.njk" import pilar as iconoPilar %}
{% set destacados = productos | selectattr("destacado") | list %}
{% set nuevos = productos | selectattr("nuevo") | list %}

{# Portada. La foto se muestra entera —nunca recortada, para que el letrero
   de neón no pierda ni un bombillo— y conserva su marco. Lo que une la foto
   con el texto no es pegarlos: es la luz. Un resplandor cálido sale de
   detrás de la imagen y baña el papel hacia la izquierda, y un segundo marco
   finísimo, corrido, cruza hacia el lado del texto. Los detalles están en
   estilos.css. #}
<section class="hero">
  {# La foto va FUERA del contenedor, como hija directa de la sección: así
     ocupa el ancho completo de la pantalla sin márgenes negativos que haya
     que cuadrar con el relleno del contenedor en cada tamaño. #}
  <div class="hero__foto">
    {% set portada = negocio.fotoPrincipal %}
    {% if not portada %}{% set portada = (productos | selectattr("destacado") | first).fotos[0] %}{% endif %}
    {% if portada %}
    <div class="hero__marco">
      {# En computador entra la foto horizontal; en celular, la vertical.
         El navegador descarga una sola, la que le toca. #}
      <picture>
        {% if negocio.fotoPrincipalAncha %}<source media="(min-width: 901px)" srcset="{{ negocio.fotoPrincipalAncha }}">{% endif %}
        <img src="{{ portada }}" alt="{{ negocio.fotoPrincipalAlt or negocio.titular }}" width="1100" height="1881" fetchpriority="high">
      </picture>
    </div>
    {% endif %}
  </div>

  <div class="contenedor hero__fila">
    <div class="hero__texto">
      <div class="hero__caja">
        <p class="rotulo rotulo--luces">Fábrica y galería en Aranjuez</p>
        <h1 class="hero__titular">{{ negocio.titular }}</h1>
        <p class="hero__entrada">{{ negocio.presentacion }}</p>
        <div class="hero__botones">
          <a class="boton boton--oscuro boton--grande" href="/catalogo/">Ver el catálogo</a>
          <a class="boton boton--linea boton--grande" href="/categoria/tocadores-120/">Ver tocadores</a>
        </div>
        <dl class="cifras">
          <div><dt>7</dt><dd>Años en el mercado</dd></div>
          <div><dt>{{ productos.length }}</dt><dd>Productos</dd></div>
          <div><dt>10–15</dt><dd>Días hábiles</dd></div>
        </dl>
      </div>
    </div>

  </div>
</section>

{% if negocio.fraseMarca or negocio.trayectoria %}
{# Franja de marca: lo que el negocio dice de sí mismo, entre la portada y
   el catálogo. Si el dueño vacía los dos campos, la franja desaparece. #}
<section class="marca-frase">
  <div class="contenedor">
    {% if negocio.fraseMarca %}<p class="marca-frase__texto">{{ negocio.fraseMarca }}</p>{% endif %}
    {% if negocio.trayectoria %}<p class="marca-frase__pie">{{ negocio.trayectoria }}</p>{% endif %}
  </div>
</section>
{% endif %}

{# "Encuentra el tuyo". Cada grupo lleva una mancha de color detrás del
   ícono y un dibujo plano en la esquina. Los dibujos están hechos con
   figuras, no son imágenes: no agregan ningún archivo que descargar. #}
<section class="seccion seccion--atajos">
  <div class="contenedor">
    <header class="seccion__cabeza seccion__cabeza--centrada">
      <div>
        <p class="rotulo">¿No sabes por dónde empezar?</p>
        <h2>Encuentra el tuyo</h2>
      </div>
    </header>
    <div class="atajos">
      {% for a in negocio.atajos %}
      <div class="atajo atajo--{{ a.icono or 'brujula' }}">
        {{ ilustracion(a.icono) }}
        <div class="atajo__cabeza">
          <span class="atajo__icono">{{ iconoAtajo(a.icono) }}</span>
          <h3 class="atajo__titulo">{{ a.titulo }}</h3>
        </div>
        <ul class="atajo__lista">
          {% for o in a.opciones %}
          <li>
            <a class="atajo__opcion" href="{{ o.enlace }}">
              <span>{{ o.texto }}</span>
              <svg class="atajo__flecha" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13"></path><path d="M12.6 6l6 6-6 6"></path></svg>
            </a>
          </li>
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="seccion" id="lineas">
  <div class="contenedor">
    <header class="seccion__cabeza">
      <div>
        <p class="rotulo">El catálogo</p>
        <h2>Compra por línea</h2>
      </div>
      <a class="enlace-subrayado" href="/catalogo/">{{ "Ver el producto" if productos.length == 1 else "Ver los " + (productos.length | string) + " productos" }}</a>
    </header>
    {% for clave, g in grupos %}
    {% set delGrupo = categorias | deGrupo(clave) %}
    {% set enGrupo = productos | cuentaGrupo(categorias, clave) %}
    <div class="grupo">
      <div class="grupo__cabeza">
        <h3 class="grupo__nombre">{{ g.nombre }}</h3>
        <span class="grupo__cuenta">{{ delGrupo | length }} línea{{ "s" if delGrupo | length != 1 }} · {{ enGrupo }} producto{{ "s" if enGrupo != 1 }}</span>
      </div>
      <p class="grupo__entrada">{{ g.descripcion }}</p>
      <div class="rejilla rejilla--{{ delGrupo | length if delGrupo | length < 5 else 3 }}">
        {% for c in delGrupo %}
        {% set cuantos = productos | deCategoria(c.slug) | length %}
        <a class="categoria" href="/categoria/{{ c.slug }}/">
          <div class="foto foto--4-5">
            {% if c.foto %}
            <img src="{{ c.foto }}" alt="{{ c.nombre }}" loading="lazy" width="400" height="500">
            {% else %}
            <span class="foto__vacia">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="3" y="4.5" width="18" height="15" rx="2"></rect><circle cx="8.8" cy="10" r="1.9"></circle><path d="M3.5 17.2l5-4.2 3.6 3 3-2.4 5.4 4.6"></path></svg>
              <span>Foto</span>
            </span>
            {% endif %}
          </div>
          <h4>{{ c.nombre }}</h4>
          <p>{{ cuantos }} producto{{ "s" if cuantos != 1 }}</p>
        </a>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>
</section>

{% if destacados.length %}
<section class="seccion">
  <div class="contenedor">
    <header class="seccion__cabeza">
      <div>
        <p class="rotulo">Los más pedidos</p>
        <h2>Favoritos de la casa</h2>
      </div>
      <a class="enlace-subrayado" href="/catalogo/">Ver todos</a>
    </header>
    {# La rejilla se ajusta a cuántos haya marcados: con uno o dos, una
         rejilla de cuatro deja media fila vacía y parece un error. #}
    <div class="rejilla rejilla--{{ 4 if destacados | length > 4 else destacados | length }}">
      {% for p in destacados | primeros(4) %}{{ producto(p, negocio) }}{% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if nuevos.length %}
<section class="seccion">
  <div class="contenedor">
    <header class="seccion__cabeza">
      <div>
        <p class="rotulo">Recién llegados</p>
        <h2>Nuevos lanzamientos</h2>
      </div>
      <a class="enlace-subrayado" href="/catalogo/">Ver todos</a>
    </header>
    {# La rejilla se ajusta a cuántos haya marcados: con uno o dos, una
         rejilla de cuatro deja media fila vacía y parece un error. #}
    <div class="rejilla rejilla--{{ 4 if nuevos | length > 4 else nuevos | length }}">
      {% for p in nuevos | primeros(4) %}{{ producto(p, negocio) }}{% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="pilares">
  <div class="contenedor pilares__fila">
    <div class="pilar">
      <h3 class="pilar__titulo"><span class="pilar__icono">{{ iconoPilar("tarjeta") }}</span>Pago contra entrega</h3>
      <p>{{ negocio.formasDePago }}</p>
    </div>
    <div class="pilar">
      <h3 class="pilar__titulo"><span class="pilar__icono">{{ iconoPilar("corazon") }}</span>En tus colores</h3>
      <p>Se fabrica en {% for c in negocio.colores %}{{ c.nombre | lower }}{% if not loop.last %}, {% endif %}{% endfor %}, con enchape {% for e in negocio.enchapes %}{{ e | lower }}{% if not loop.last %}, {% endif %}{% endfor %}.</p>
    </div>
    <div class="pilar">
      <h3 class="pilar__titulo"><span class="pilar__icono">{{ iconoPilar("camion") }}</span>Domicilios en Medellín</h3>
      <p>{{ negocio.domicilios }}</p>
    </div>
    <div class="pilar">
      <h3 class="pilar__titulo"><span class="pilar__icono">{{ iconoPilar("reloj") }}</span>Fabricación bajo pedido</h3>
      <p>{{ negocio.plazoFabricacion }}</p>
    </div>
  </div>
</section>

<section class="seccion" id="asesores">
  <div class="contenedor dos-columnas">
    <div>
      {# Aquí NO se explica cómo se reparten las comisiones. El visitante es un
         cliente, no un vendedor: lo que le sirve saber es que lo atiende un
         equipo y que siempre le responde la misma persona. El reparto es un
         asunto interno y vive en /equipo/, que va con noindex. #}
      <p class="rotulo">{% set nAs = asesores | activos | length %}{{ nAs }} línea{{ "s" if nAs != 1 }} de atención</p>
      <h2>Te atiende nuestro equipo</h2>
      <p class="parrafo">Resolvemos dudas de medidas, colores y enchapes, confirmamos el domicilio y te damos seguimiento hasta que el mueble esté en tu casa. La misma persona te acompaña durante toda la compra.</p>
      <a class="boton boton--linea" href="/asesores/">Ver las líneas autorizadas</a>
    </div>
    <div class="caja">
      <h3 class="rotulo">Tu línea de atención</h3>
      <p class="caja__dato"><strong data-asesor-nombre>{{ negocio.nombre }}</strong></p>
      <p class="caja__nota" data-asesor-origen>Te atiende nuestra línea principal de atención.</p>
      <a class="boton boton--whatsapp" href="#" data-wa data-wa-texto="¡Hola {{ negocio.nombre }}! Quiero hacer un pedido:">Escribir por WhatsApp</a>
      <p class="caja__nota">{{ negocio.atribucion.notaRegla }}</p>
    </div>
  </div>
</section>

<section class="seccion" id="galeria">
  <div class="contenedor">
    <div class="galeria">
      <div class="galeria__texto">
        <p class="rotulo">Visítanos</p>
        <h2>Galería {{ negocio.nombre }}, Aranjuez</h2>
        <h3 class="rotulo">Dirección</h3>
        <p class="parrafo">{{ negocio.direccion }}</p>
        <h3 class="rotulo">Horario</h3>
        <p class="parrafo">
          {% for h in negocio.horario %}{{ h.dias }}: {% if h.nota %}{{ h.nota }}{% else %}{{ h.desde }} a {{ h.hasta }}{% endif %}<br>{% endfor %}
        </p>
        <h3 class="rotulo">Teléfono</h3>
        <p class="parrafo">{{ negocio.telefono }}</p>

        <div class="galeria__botones">
          {# El href de respaldo apunta a la línea principal por si el
             visitante tiene el JavaScript desactivado; con JavaScript se
             reemplaza por el WhatsApp del asesor que lo está atendiendo. #}
          <a class="boton boton--whatsapp"
             href="https://wa.me/{{ negocio.telefonoWhatsapp }}?text={{ ('¡Hola ' + negocio.nombre + '! Quiero preguntar por la galería:') | urlencode }}"
             data-wa data-wa-texto="¡Hola {{ negocio.nombre }}! Quiero preguntar por la galería:">
            <img class="wa-logo" src="/img/whatsapp.svg" alt="" width="17" height="17" aria-hidden="true">
            Escribir por WhatsApp
          </a>
          {% if negocio.latitud and negocio.longitud %}
          <a class="boton boton--oscuro" href="https://www.google.com/maps/dir/?api=1&destination={{ negocio.latitud }}%2C{{ negocio.longitud }}" target="_blank" rel="noopener">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z"></path><circle cx="12" cy="10" r="2.6"></circle></svg>
            Cómo llegar
          </a>
          {% endif %}
        </div>
        {% if negocio.latitud and negocio.longitud %}
        <p class="nota">El mapa se abre en tu aplicación con la ruta desde donde estés.</p>
        {% endif %}
      </div>
      <div class="galeria__mapa">
        {% if negocio.latitud and negocio.longitud %}
        <iframe
          src="https://www.google.com/maps?q={{ negocio.latitud }},{{ negocio.longitud }}&hl=es&z=17&output=embed"
          title="Mapa de la galería {{ negocio.nombre }} en {{ negocio.direccion }}"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
        {% else %}
        <span class="foto__vacia">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z"></path><circle cx="12" cy="10" r="2.6"></circle></svg>
          <span>Mapa · {{ negocio.direccion }}</span>
        </span>
        {% endif %}
      </div>
    </div>
  </div>
</section>
