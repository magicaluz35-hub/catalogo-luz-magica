<footer class="pie">
  <div class="contenedor">
    <div class="pie__columnas">
      <div>
        <span class="marca__nombre marca__nombre--claro">{{ negocio.nombre }}</span>
        <span class="marca__lema marca__lema--claro">{{ negocio.lema }}</span>
        {# Si en img/ está el logo oficial de la red (instagram.svg,
           facebook.svg, tiktok.svg) se muestra el logo; si no, queda el
           nombre escrito. Subir el archivo basta: no hay que tocar nada
           más para que cambie. #}
        <div class="pie__redes">
          {% for red in [
            { clave: "instagram", nombre: "Instagram" },
            { clave: "facebook",  nombre: "Facebook" },
            { clave: "tiktok",    nombre: "TikTok" }
          ] %}
          {% set enlace = negocio.redes[red.clave] %}
          {% if enlace %}
          {% set logo = "/img/" + red.clave + ".svg" %}
          <a href="{{ enlace }}" rel="noopener" target="_blank"
             class="{{ 'pie__red' if logo | existe }}"
             aria-label="{{ negocio.nombre }} en {{ red.nombre }}">
            {% if logo | existe %}
            <img src="{{ logo }}" alt="" width="22" height="22" loading="lazy">
            {% else %}{{ red.nombre }}{% endif %}
          </a>
          {% endif %}
          {% endfor %}
        </div>
      </div>

      <div>
        <h2 class="pie__titulo">Catálogo</h2>
        {% for c in categorias | primeros(5) %}
        <p><a href="/categoria/{{ c.slug }}/">{{ c.nombre }}</a></p>
        {% endfor %}
        <p><a href="/catalogo/">Ver todo</a></p>
      </div>

      <div>
        <h2 class="pie__titulo">Galería</h2>
        <p>{{ negocio.direccion }}</p>
        {% for h in negocio.horario %}
        <p>{{ h.dias }}: {% if h.nota %}{{ h.nota }}{% else %}{{ h.desde }} a {{ h.hasta }}{% endif %}</p>
        {% endfor %}
        {# Sin enlace de llamada: todo el contacto va por WhatsApp, que es
           donde el asesor queda registrado. #}
        <p>{{ negocio.telefono }}</p>
      </div>

      <div>
        <h2 class="pie__titulo">Formas de pago</h2>
        <p class="pie__legal">{{ negocio.formasDePago }}</p>
        <p class="pie__legal">{{ negocio.domicilios }}</p>
        <p><a href="/asesores/">Asesores autorizados</a></p>
      </div>
    </div>

    <p class="pie__creditos">© {{ anio }} {{ negocio.nombre }} · {{ negocio.direccion }}</p>
  </div>
</footer>
