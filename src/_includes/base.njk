<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ titulo or negocio.nombre }}</title>
<meta name="description" content="{{ descripcion or negocio.descripcionCorta }}">

<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ negocio.nombre }}">
<meta property="og:locale" content="es_CO">
<meta property="og:title" content="{{ titulo or negocio.nombre }}">
<meta property="og:description" content="{{ descripcion or negocio.descripcionCorta }}">
<meta property="og:url" content="{{ negocio.dominio }}{{ page.url }}">
<meta property="og:image" content="{{ negocio.dominio }}{{ ogImagen or negocio.fotoPrincipal or negocio.logo }}">
<meta name="twitter:card" content="summary_large_image">

<meta name="theme-color" content="#FFFFFF">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Jost:wght@400;500;600&display=swap">
<link rel="stylesheet" href="/assets/estilos.css">

{% if negocio.introMarca != false %}
{# Decide si va la presentación de marca. Este pedacito suelto tiene que
   correr ANTES de que se pinte la página: si esperara al archivo de
   JavaScript, el visitante alcanzaría a ver el catálogo y encima le caería
   el telón. Son cuatro líneas, no pide ningún archivo y no frena la carga.

   No se muestra por tres razones: ya se vio en esta visita, el visitante
   pidió menos animaciones en su teléfono, o el navegador no deja guardar
   nada (modo privado). En los tres casos se entra directo al catálogo. #}
<script>
(function () {
  try {
    if (window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    // Solo en el inicio. Un enlace de asesor cae casi siempre en un tocador
    // puntual: ahí el cliente viene a ver ESE mueble, y meterle tres
    // segundos de telón en el momento de más ganas cuesta ventas. El inicio
    // sí es una entrada, y ahí la presentación tiene sentido.
    if (location.pathname !== "/") return;

    // sessionStorage y no localStorage: sessionStorage vive por PESTAÑA. Así
    // la presentación no se repite mientras el visitante recorre el catálogo
    // —que era la molestia—, pero sí vuelve a salir si entra al inicio en una
    // pestaña nueva, que es una entrada nueva de verdad. Es también la forma
    // de volver a verla sin tocar nada: abrir el inicio en otra pestaña.
    if (sessionStorage.getItem("lm_intro")) return;
    sessionStorage.setItem("lm_intro", "1");

    document.documentElement.classList.add("con-intro");
  } catch (e) { /* sin memoria: se entra directo */ }
})();
</script>
{% endif %}

<script type="application/json" id="datos-asesores">{{ asesores | dump | safe }}</script>
<script type="application/json" id="datos-negocio">{{ { "whatsapp": negocio.telefonoWhatsapp, "regla": negocio.atribucion.regla, "dias": negocio.atribucion.diasVigencia, "horario": negocio.horario } | dump | safe }}</script>
</head>
<body>

{% if negocio.introMarca != false %}{% include "intro.njk" %}{% endif %}

<div class="promesas">
  {% for p in negocio.promesas %}<span>{{ p }}</span>{% if not loop.last %}<span aria-hidden="true" class="punto">·</span>{% endif %}{% endfor %}
</div>

<div class="asesor-barra">
  <div class="contenedor asesor-barra__fila">
    <div class="asesor-barra__quien">
      <span class="asesor-barra__ficha" aria-hidden="true" data-asesor-codigo>00</span>
      <span>Te atiende <strong data-asesor-nombre>{{ negocio.nombre }}</strong> · asesor autorizado</span>
    </div>
    <div class="asesor-barra__info">
      <span class="estado" data-estado-horario><span class="punto-estado" aria-hidden="true"></span><span class="estado__largo" data-estado-texto>Consultando horario…</span><span class="estado__corto" data-estado-corto aria-hidden="true">…</span></span>
      <a href="/asesores/">¿Te escribieron de otro número? Verifícalo</a>
    </div>
  </div>
</div>

{% include "cabecera.njk" %}

<main id="contenido">
{{ content | safe }}
</main>

{% include "pie.njk" %}

{# No va donde ya hay un botón de WhatsApp a la vista: en la ficha sería el
   mismo botón dos veces, y en la página del pedido se saltaría el
   formulario obligatorio. Cada plantilla lo pide con sinFlotante. #}
{% if not sinFlotante %}
<a class="wa-flotante" href="#" data-wa data-wa-texto="¡Hola {{ negocio.nombre }}! Quiero hacer un pedido:" aria-label="Pedir por WhatsApp">
  {# Logo oficial de WhatsApp, descargado del Brand Resource Center de Meta.
     No se modifica ni se recolorea: va blanco sobre el verde del botón. #}
  <img class="wa-logo" src="/img/whatsapp.svg" alt="" width="22" height="22" aria-hidden="true">
  {# En celular se acorta el texto, pero la palabra "WhatsApp" nunca
     desaparece: sin ella el botón era solo un globo sin dueño. #}
  <span class="wa-flotante__largo">Pedir por WhatsApp</span>
  <span class="wa-flotante__corto">WhatsApp</span>
</a>
{% endif %}

<script src="/assets/catalogo.js" defer></script>
</body>
</html>
