---
layout: base.njk
permalink: /disena/
titulo: Diseña el tuyo · Luz Mágica
descripcion: Arma tu mueble eligiendo línea, color, enchape y medida, y envíalo listo por WhatsApp.
---
<section class="disena">
  <div class="contenedor dos-columnas">

    <div>
      <p class="rotulo rotulo--claro">Hecho para ti</p>
      <h1 class="titulo-claro">Diseña el tuyo</h1>
      <p class="parrafo parrafo--claro">Arma tu mueble en cuatro toques y envíanos la ficha lista por WhatsApp. Nada se cobra hasta que confirmes en la conversación.</p>

      <div class="previsualizacion previsualizacion--oscura">
        <p class="rotulo rotulo--claro">Tu mensaje de WhatsApp</p>
        <p data-wa-previo></p>
      </div>
    </div>

    <form class="caja caja--blanca" data-opciones data-disena>
      <fieldset>
        <legend class="rotulo">1 · Mueble</legend>
        <div class="fichas">
          {% for ct in categorias %}
          <label class="ficha ficha--radio">
            <input type="radio" name="linea" value="{{ ct.nombre }}" {{ "checked" if loop.first }}>
            <span>{{ ct.nombre }}</span>
          </label>
          {% endfor %}
        </div>
      </fieldset>

      <fieldset>
        <legend class="rotulo">2 · Color del mueble</legend>
        <div class="muestras">
          {% for c in negocio.colores %}
          <label class="muestra">
            <input type="radio" name="color" value="{{ c.nombre }}" {{ "checked" if loop.first }}>
            <span class="muestra__disco" style="background: {{ c.hex }}"></span>
            <span class="oculto">{{ c.nombre }}</span>
          </label>
          {% endfor %}
        </div>
        <p class="opciones__elegido">Elegido: <strong data-elegido-color>{{ negocio.colores[0].nombre }}</strong></p>
      </fieldset>

      <fieldset>
        <legend class="rotulo">3 · Enchape</legend>
        <div class="fichas">
          {% for e in negocio.enchapes %}
          <label class="ficha ficha--radio">
            <input type="radio" name="enchape" value="{{ e }}" {{ "checked" if loop.first }}>
            <span>{{ e }}</span>
          </label>
          {% endfor %}
        </div>
      </fieldset>

      <fieldset>
        <legend class="rotulo">4 · Medida</legend>
        <div class="fichas">
          {% for m in negocio.medidas %}
          <label class="ficha ficha--radio">
            <input type="radio" name="medida" value="{{ m }}" {{ "checked" if loop.first }}>
            <span>{{ m }}</span>
          </label>
          {% endfor %}
          <label class="ficha ficha--radio">
            <input type="radio" name="medida" value="Otra medida">
            <span>Otra medida</span>
          </label>
        </div>
      </fieldset>

      <a class="boton boton--whatsapp boton--ancho" href="#" data-wa data-wa-disena>
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20.5 11.6a8.4 8.4 0 0 1-12.3 7.5L3.5 20.5l1.5-4.6A8.4 8.4 0 1 1 20.5 11.6z"></path></svg>
        Enviar mi diseño por WhatsApp
      </a>
      <p class="nota nota--centrada">{{ negocio.avisoWhatsapp }}</p>
    </form>

  </div>
</section>
